datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum VoteType {
  UP
  DOWN
}

enum ApiVisibility {
  PUBLIC
  PRIVATE
}

enum ApiCategory {
  FINANCE
  SOCIAL
  DATA
  AI
  HEALTH
  WEATHER
  ECOMMERCE
  COMMUNICATION
  OTHER
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
}

enum ParamLocation {
  query
  path
  header
  body
}

model User {
  userId        Int      @id @default(autoincrement())
  firstName     String?
  lastName      String?  @default("")
  gender        Gender?
  contactNumber String?
  emailId       String   @unique
  password      String?
  role          Role     @default(USER)
  points        Int      @default(0)
  createdAt     DateTime @default(now())

  threads        Thread[]
  comments       Comment[]
  threadVotes    ThreadVote[]
  commentVotes   CommentVote[]
  bookmarks      Bookmark[]
  apis           Api[]
  questAttempts  UserQuestAttempt[]
}

model Thread {
  threadId  Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  authorId  Int
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User         @relation(fields: [authorId], references: [userId])
  tags      ThreadTag[]
  comments  Comment[]
  votes     ThreadVote[]
  bookmarks Bookmark[]

  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  commentId    Int      @id @default(autoincrement())
  content      String   @db.Text
  authorId     Int
  threadId     Int
  isDeleted    Boolean  @default(false)
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User         @relation(fields: [authorId], references: [userId])
  thread Thread       @relation(fields: [threadId], references: [threadId])
  votes  CommentVote[]

  @@index([threadId])
  @@index([authorId])
}

model Tag {
  tagId   Int         @id @default(autoincrement())
  name    String      @unique
  slug    String      @unique
  threads ThreadTag[]
}

model ThreadTag {
  threadId Int
  tagId    Int

  thread Thread @relation(fields: [threadId], references: [threadId])
  tag    Tag    @relation(fields: [tagId], references: [tagId])

  @@id([threadId, tagId])
}

model ThreadVote {
  userId    Int
  threadId  Int
  type      VoteType
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [userId])
  thread Thread @relation(fields: [threadId], references: [threadId])

  @@id([userId, threadId])
}

model CommentVote {
  userId    Int
  commentId Int
  type      VoteType
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [userId])
  comment Comment @relation(fields: [commentId], references: [commentId])

  @@id([userId, commentId])
}

model Bookmark {
  userId    Int
  threadId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [userId])
  thread Thread @relation(fields: [threadId], references: [threadId])

  @@id([userId, threadId])
}

model Api {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  visibility  ApiVisibility @default(PUBLIC)
  category    ApiCategory   @default(OTHER)
  baseUrl     String?
  version     String        @default("1.0.0")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      Int
  user        User          @relation(fields: [userId], references: [userId])
  endpoints   Endpoint[]
}

model Endpoint {
  id          Int                @id @default(autoincrement())
  method      HttpMethod
  path        String
  summary     String
  description String
  tags        String[]
  apiId       Int
  api         Api                @relation(fields: [apiId], references: [id], onDelete: Cascade)
  parameters  EndpointParam[]
  requestBody Json?
  responses   EndpointResponse[]
  createdAt   DateTime           @default(now())
}

model EndpointParam {
  id          Int           @id @default(autoincrement())
  name        String
  location    ParamLocation
  required    Boolean       @default(false)
  type        String
  description String
  endpointId  Int
  endpoint    Endpoint      @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model EndpointResponse {
  id          Int      @id @default(autoincrement())
  status      Int
  description String
  example     Json?
  endpointId  Int
  endpoint    Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model Quest {
  id            Int                @id @default(autoincrement())
  date          String             @unique
  question      String
  options       Json
  correctAnswer Int
  pointsReward  Int                @default(10)
  attempts      UserQuestAttempt[]
}

model UserQuestAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int
  questId        Int
  selectedAnswer Int
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [userId])
  quest          Quest    @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
}
