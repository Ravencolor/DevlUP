// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  userId        Int       @id @default(autoincrement())
  firstName     String?
  lastName      String?   @default("")
  gender        Gender?
  contactNumber String?
  emailId       String    @unique
  password      String?
}