datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum VoteType {
  UP
  DOWN
}

model User {
  userId        Int      @id @default(autoincrement())
  firstName     String?
  lastName      String?  @default("")
  gender        Gender?
  contactNumber String?
  emailId       String   @unique
  password      String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())

  threads      Thread[]
  comments     Comment[]
  threadVotes  ThreadVote[]
  commentVotes CommentVote[]
  bookmarks    Bookmark[]
}

model Thread {
  threadId  Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  authorId  Int
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User         @relation(fields: [authorId], references: [userId])
  tags      ThreadTag[]
  comments  Comment[]
  votes     ThreadVote[]
  bookmarks Bookmark[]

  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  commentId    Int      @id @default(autoincrement())
  content      String   @db.Text
  authorId     Int
  threadId     Int
  isDeleted    Boolean  @default(false)
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User         @relation(fields: [authorId], references: [userId])
  thread Thread       @relation(fields: [threadId], references: [threadId])
  votes  CommentVote[]

  @@index([threadId])
  @@index([authorId])
}

model Tag {
  tagId   Int         @id @default(autoincrement())
  name    String      @unique
  slug    String      @unique
  threads ThreadTag[]
}

model ThreadTag {
  threadId Int
  tagId    Int

  thread Thread @relation(fields: [threadId], references: [threadId])
  tag    Tag    @relation(fields: [tagId], references: [tagId])

  @@id([threadId, tagId])
}

model ThreadVote {
  userId    Int
  threadId  Int
  type      VoteType
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [userId])
  thread Thread @relation(fields: [threadId], references: [threadId])

  @@id([userId, threadId])
}

model CommentVote {
  userId    Int
  commentId Int
  type      VoteType
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [userId])
  comment Comment @relation(fields: [commentId], references: [commentId])

  @@id([userId, commentId])
}

model Bookmark {
  userId    Int
  threadId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [userId])
  thread Thread @relation(fields: [threadId], references: [threadId])

  @@id([userId, threadId])
}
